all:
  children:
    torwatch:
      hosts:
        torwatch-prod:
          # EXAMPLE ONLY — real target lives in ~/s4y/oci/ansible/inventory.yml
          # (torwatch-prod is vps1). Copy this file to inventory/hosts.yml
          # (gitignored) and fill in real values, or run the deploy from the
          # OCI repo instead (see README).
          ansible_host: torwatch.s4y.solutions
          ansible_user: your-deploy-user
          ansible_ssh_private_key_file: ~/.ssh/your_deploy_key
          ansible_become: true
